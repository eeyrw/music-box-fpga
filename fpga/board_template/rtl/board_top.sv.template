// Synthesis/IO smoke-test scaffold. Rename after selecting a board. The final
// board top must instantiate voice_major_render_core, memory, effects and I2S.
module board_top (
  input  logic clk_in,
  input  logic rst_n,
  input  logic spi_sclk,
  input  logic spi_cs_n,
  input  logic spi_mosi,
  output logic spi_miso,
  output logic i2s_bclk,
  output logic i2s_lrclk,
  output logic i2s_sdata,
  output logic led_underrun,
  output logic led_sample_drop
);
  logic clk_sys;
  logic rst_sys;

  // TODO: Replace with the board PLL/MMCM and reset synchronizer.
  assign clk_sys = clk_in;
  assign rst_sys = !rst_n;

  // TODO: Replace these ties with the new system wrapper. Keeping the scaffold
  // independent prevents a removed legacy renderer from becoming a dependency.
  always_comb begin
    spi_miso = spi_cs_n | spi_sclk | spi_mosi | clk_sys | rst_sys;
    i2s_bclk = 1'b0;
    i2s_lrclk = 1'b0;
    i2s_sdata = 1'b0;
    led_underrun = 1'b0;
    led_sample_drop = 1'b0;
  end
endmodule
